}}%%

flowchart LR

  %% ============ actors ============
  USER("👤 User wallet · 6UBWeY…HBMy
  devnet · signer · fees + rent payer")

  SYS["⚙️ System Program (native)
  lamport transfer + account creation"]

  subgraph VP["🐍 pre-req-vault program — OURS · 6i1kTZWF…ASoZ · devnet"]
    direction TB
    INIT["initialize()"]
    DEP["deposit(amount)"]
    WIT["withdraw(amount, github)"]
    CLOSE["close()"]
    STATE[["🏛️ VaultState PDA · seeds [state, user]
    stores { vault_bump, state_bump }"]]
    VAULT[["💎 vault PDA · seeds [vault, vault_state]
    holds the SOL · signs via seeds + bump"]]
  end

  subgraph REG["🏫 Turbin3 registration program — EXTERNAL · q3_pre_reqs_rs · TRBZyQHB…aKWDM"]
    RINIT["initialize(github)"]
    APP[["📋 prereqs PDA · seeds [prereqs, user] @ TRBZ
    ApplicationAccount { user, bump, pre_req_ts, pre_req_rs, github }
    ⚠ one per wallet · written only via CPI"]]
  end

  %% ============ 1 · initialize ============
  USER -- "1 · initialize()" --> INIT
  INIT -. "creates VaultState · payer = user
  stores both bumps" .-> STATE

  %% ============ 2 · deposit ============
  USER -- "2 · deposit(amount)" --> DEP
  DEP -- "System CPI: transfer" --> SYS
  SYS -. "user → vault transfer
  (creates vault a/c on 1st deposit)" .-> VAULT

  %% ============ 3 · withdraw + CPI ============
  USER -- "3 · withdraw(amount, github)" --> WIT
  WIT -. "vault → user transfer
  vault signs via seeds" .-> USER
  WIT == "CPI initialize(github)
  user signer inherited" ==> RINIT
  RINIT -. "creates prereqs PDA · records github" .-> APP

  %% ============ 4 · close ============
  USER -- "4 · close()" --> CLOSE
  CLOSE -. "drains vault → user
  closes VaultState (rent refund)" .-> USER

